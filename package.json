{
  "name": "jaga-claim",
  "version": "1.0.0",
  "description": "JAGA-CLAIM Web MVP - Pre-submit Risk Scoring & Review Platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/unit",
    "test:integration": "node --env-file=.env scripts/run-isolated-tests.js tests/integration",
    "test:workflow": "node --env-file=.env scripts/run-isolated-tests.js tests/e2e",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:ml:live": "node --env-file=.env scripts/run-live-ml-contract.js",
    "perf:check": "node --env-file=.env scripts/performance-sanity.js",
    "test:all": "npm run test && npm run test:integration && npm run test:workflow && npm run test:e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:check": "node --env-file=.env scripts/db-check.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "db:purge-demo": "node --env-file=.env scripts/purge-demo-data.js",
    "db:reset": "node --env-file=.env scripts/reset-dev.js"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.7.7",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
